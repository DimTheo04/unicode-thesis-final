// Prisma schema file conforming to project rules (snake_case in DB, PascalCase models)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum SubmissionStatus {
  SUBMITTED
  REVIEWED
  RESUBMISSION_REQUESTED
}

enum EnrollmentStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model User {
  id           String    @id @default(uuid())
  username     String    @unique @map("username")
  fullName     String    @map("full_name")
  email        String    @unique @map("email")
  dateOfBirth  DateTime  @map("date_of_birth")
  passwordHash String    @map("password_hash")
  role         Role      @default(STUDENT) @map("role")
  isApproved   Boolean   @default(false) @map("is_approved")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  // Teacher relations
  taughtCourses Course[] @relation("TeacherCourses")

  // Student relations
  enrollments Enrollment[]
  submissions Submission[]

  // Comments and Messages
  comments         InlineComment[]
  threadMessages   ThreadMessage[]
  notifications    Notification[]
  commentReadStates CommentReadState[]

  @@map("users")
}

model Course {
  id          String   @id @default(uuid())
  code        String   @unique @map("code")
  title       String   @map("title")
  description String?  @map("description")
  teachers    User[]   @relation("TeacherCourses")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  enrollments Enrollment[]
  assignments Assignment[]

  @@map("courses")
}

model Enrollment {
  id        String   @id @default(uuid())
  courseId  String   @map("course_id")
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  studentId String           @map("student_id")
  student   User             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status    EnrollmentStatus @default(PENDING) @map("status")
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  @@unique([courseId, studentId])
  @@map("enrollments")
}

model Assignment {
  id          String   @id @default(uuid())
  title       String   @map("title")
  description String   @map("description")
  dueDate     DateTime @map("due_date")
  courseId    String   @map("course_id")
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  submissions Submission[]
  attachments AssignmentAttachment[]

  @@map("assignments")
}

model AssignmentAttachment {
  id           String     @id @default(uuid())
  assignmentId String     @map("assignment_id")
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  fileName     String     @map("file_name")
  fileUrl      String     @map("file_url")
  fileType     String     @map("file_type")
  createdAt    DateTime   @default(now()) @map("created_at")

  @@map("assignment_attachments")
}

model Submission {
  id           String           @id @default(uuid())
  assignmentId String           @map("assignment_id")
  assignment   Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId    String           @map("student_id")
  student      User             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  version      Int              @default(1) @map("version")
  fileTreeJson String           @map("file_tree_json")
  zipFilePath  String?          @map("zip_file_path")
  status       SubmissionStatus @default(SUBMITTED) @map("status")
  grade        Float?           @map("grade")
  feedback     String?          @map("feedback")
  hasSeenGrade Boolean          @default(false) @map("has_seen_grade")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  inlineComments InlineComment[]

  @@map("submissions")
}

model InlineComment {
  id           String     @id @default(uuid())
  submissionId String     @map("submission_id")
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  version      Int        @default(1) @map("version")
  filePath     String     @map("file_path")
  startLine    Int        @map("start_line")
  endLine      Int        @map("end_line")
  authorId     String     @map("author_id")
  author       User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content      String     @map("content")
  isResolved   Boolean    @default(false) @map("is_resolved")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  threadMessages ThreadMessage[]
  readStates     CommentReadState[]

  @@map("inline_comments")
}

model CommentReadState {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  commentId  String   @map("comment_id")
  comment    InlineComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  lastReadAt DateTime @default(now()) @map("last_read_at")

  @@unique([userId, commentId])
  @@map("comment_read_states")
}

model ThreadMessage {
  id        String        @id @default(uuid())
  commentId String        @map("comment_id")
  comment   InlineComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  authorId  String        @map("author_id")
  author    User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String        @map("content")
  createdAt DateTime      @default(now()) @map("created_at")

  @@map("thread_messages")
}

model Notification {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String   @map("type") // e.g., 'NEW_COMMENT', 'REPLY_ADDED'
  title      String
  message    String
  actionData Json     @map("action_data")
  isRead     Boolean  @default(false) @map("is_read")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("notifications")
}


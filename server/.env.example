# Node Environment
NODE_ENV=development
PORT=5000

# PostgreSQL Database Connection URL (Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/codereview_db?schema=public"

# Mandatory Cryptographic JWT Secret (Generate via: openssl rand -base64 32)
JWT_SECRET="your-super-secret-cryptographic-jwt-key-min-32-chars"

# Allowed Frontend Client Origin for CORS
CLIENT_ORIGIN="http://localhost:5173"

# Google Gemini API Key for AI Code Review Analysis
GEMINI_API_KEY="your-google-gemini-api-key-here"
